# 血染钟楼 AI 说书人 - 环境变量配置模板
# 请复制此文件并重命名为 .env 后填入实际值

# LLM 提供商选择（可选，默认 ark）
# 可选值: ark | claude
# LLM_PROVIDER=ark

# ── Ark（字节跳动）配置 ──────────────────────────────────────────────────────
BASE_URL=your_api_base_url
MODEL=your_model_name
API_KEY=your_api_key

# ── Claude（Anthropic）配置 ─────────────────────────────────────────────────
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=your_anthropic_api_key
# CLAUDE_MODEL=claude-sonnet-4-6   # 可选，默认 claude-sonnet-4-6
# CLAUDE_BASE_URL=                  # 可选，使用代理时填写

# 调试模式 (可选)
# 设置为 1 以启用调试模式，固定剧本与玩家数量（默认8人）
# DEBUG=1
