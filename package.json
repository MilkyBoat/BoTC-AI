{
  "name": "botc-ai",
  "version": "0.1.0",
  "description": "Browser-hosted Blood on the Clocktower game with AI storytellers and players",
  "author": "BotC-AI contributors; based on townsquare by Steffen Baumgart",
  "scripts": {
    "serve": "vue-cli-service serve",
    "relay:dev": "NODE_ENV=development node server/index.js",
    "build": "vue-cli-service build ./src/main.js",
    "lint": "vue-cli-service lint",
    "lint-ci": "vue-cli-service lint --no-fix --max-warnings=415",
    "test:unit": "vue-cli-service test:unit tests/unit --runInBand",
    "test:component": "vue-cli-service test:unit tests/component --runInBand",
    "test:scenario": "vue-cli-service test:unit tests/scenario --runInBand",
    "test:integration": "vue-cli-service test:unit tests/integration --runInBand",
    "test:fast": "npm run test:unit && npm run test:component && npm run test:scenario && npm run test:integration",
    "test:coverage": "vue-cli-service test:unit --coverage --runInBand",
    "test:e2e": "playwright test",
    "test:ci": "npm run test:fast && npm run lint-ci && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "main": "App.vue",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.32",
    "@fortawesome/free-brands-svg-icons": "^5.15.1",
    "@fortawesome/free-solid-svg-icons": "^5.15.1",
    "@fortawesome/vue-fontawesome": "^0.1.10",
    "@vue/cli-service": "^5.0.8",
    "prom-client": "^13.0.0",
    "sass": "^1.30.0",
    "sass-loader": "^8.0.2",
    "vue": "^2.6.12",
    "vue-template-compiler": "^2.7.15",
    "vuex": "^3.6.0",
    "ws": "^7.4.6"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@playwright/test": "1.61.1",
    "@vue/cli-plugin-eslint": "^5.0.8",
    "@vue/cli-plugin-unit-jest": "5.0.9",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/test-utils": "1.3.6",
    "@vue/vue2-jest": "27.0.0",
    "ajv": "6.12.6",
    "eslint": "^8.53.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-vue": "^9.18.1",
    "prettier": "^3.0.3"
  },
  "keywords": [
    "botc",
    "townsquare",
    "vue",
    "scss"
  ],
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MilkyBoat/BotC-AI.git"
  }
}
