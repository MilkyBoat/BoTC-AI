{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://botc-ai.local/schemas/wiki-sync.config.schema.json",
  "title": "BotC-AI Wiki 同步配置",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "baseUrl",
    "allowedOrigins",
    "sourceManifest",
    "request"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "allowedOrigins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "sourceManifest": { "type": "string", "minLength": 1 },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userAgent",
        "minIntervalMs",
        "timeoutMs",
        "retries",
        "maxResponseBytes"
      ],
      "properties": {
        "userAgent": {
          "type": "string",
          "pattern": "ClocktowerKnowledgeSync"
        },
        "minIntervalMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 5 },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        }
      }
    }
  }
}
