{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://botc-ai.local/schema/domain-protocol-v0.3.0.json",
  "$ref": "#/definitions/eventStream",
  "definitions": {
    "protocolVersion": {
      "const": "0.3.0"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "messageType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["host", "system", "seat", "observer", "agent"]
        },
        "id": {
          "$ref": "#/definitions/stableId"
        }
      }
    },
    "rulesetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "canonicalLanguage",
        "sourceManifestVersion",
        "integrity"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/stableId"
        },
        "version": {
          "$ref": "#/definitions/semanticVersion"
        },
        "canonicalLanguage": {
          "const": "zh-CN"
        },
        "sourceManifestVersion": {
          "$ref": "#/definitions/semanticVersion"
        },
        "integrity": {
          "$ref": "#/definitions/sha256"
        }
      }
    },
    "commandEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "commandId",
        "gameId",
        "expectedRevision",
        "actor",
        "type",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "#/definitions/protocolVersion"
        },
        "commandId": {
          "$ref": "#/definitions/stableId"
        },
        "gameId": {
          "$ref": "#/definitions/stableId"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actor": {
          "$ref": "#/definitions/actor"
        },
        "type": {
          "$ref": "#/definitions/messageType"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "eventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "eventId",
        "gameId",
        "sequence",
        "type",
        "causationId",
        "actor",
        "recordedAt",
        "ruleset",
        "payload"
      ],
      "properties": {
        "protocolVersion": {
          "$ref": "#/definitions/protocolVersion"
        },
        "eventId": {
          "$ref": "#/definitions/stableId"
        },
        "gameId": {
          "$ref": "#/definitions/stableId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "$ref": "#/definitions/messageType"
        },
        "causationId": {
          "$ref": "#/definitions/stableId"
        },
        "actor": {
          "$ref": "#/definitions/actor"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "ruleset": {
          "$ref": "#/definitions/rulesetIdentity"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "gameId",
        "ruleset",
        "seed",
        "revision",
        "lifecycle",
        "phase",
        "dayNumber",
        "nightNumber",
        "seats",
        "executionToday",
        "winner",
        "nominationsToday",
        "activeNomination",
        "highestNominationVotes",
        "executionCandidate",
        "exilesToday",
        "activeExile"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/definitions/protocolVersion"
        },
        "gameId": {
          "$ref": "#/definitions/stableId"
        },
        "ruleset": {
          "$ref": "#/definitions/rulesetIdentity"
        },
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lifecycle": { "enum": ["preparing", "running", "ended"] },
        "phase": {
          "enum": ["setup", "first-night", "day", "night", "ended"]
        },
        "dayNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nightNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "seats": {
          "type": "array",
          "items": { "$ref": "#/definitions/basicSeatState" }
        },
        "executionToday": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/definitions/executionState" }
          ]
        },
        "winner": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/winnerState" }]
        },
        "nominationsToday": {
          "type": "array",
          "items": { "$ref": "#/definitions/nominationRecord" }
        },
        "activeNomination": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/definitions/activeNomination" }
          ]
        },
        "highestNominationVotes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executionCandidate": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/definitions/executionCandidateState" }
          ]
        },
        "exilesToday": {
          "type": "array",
          "items": { "$ref": "#/definitions/exileRecord" }
        },
        "activeExile": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/activeExile" }]
        }
      }
    },
    "receiptError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "details": {
          "type": "object"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "commandId",
        "commandFingerprint",
        "gameId",
        "status",
        "revisionBefore",
        "revisionAfter",
        "eventIds",
        "recordedAt"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/definitions/protocolVersion"
        },
        "commandId": {
          "$ref": "#/definitions/stableId"
        },
        "commandFingerprint": {
          "$ref": "#/definitions/sha256"
        },
        "gameId": {
          "$ref": "#/definitions/stableId"
        },
        "status": {
          "enum": ["accepted", "rejected"]
        },
        "revisionBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revisionAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eventIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/stableId"
          }
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "$ref": "#/definitions/receiptError"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "accepted" }
            }
          },
          "then": {
            "not": { "required": ["error"] }
          },
          "else": {
            "required": ["error"],
            "properties": {
              "eventIds": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "eventStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "protocolVersion",
        "gameId",
        "ruleset",
        "events",
        "receipts"
      ],
      "properties": {
        "formatVersion": {
          "$ref": "#/definitions/protocolVersion"
        },
        "protocolVersion": {
          "$ref": "#/definitions/protocolVersion"
        },
        "gameId": {
          "$ref": "#/definitions/stableId"
        },
        "ruleset": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/definitions/rulesetIdentity" }
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/eventEnvelope"
          }
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/receipt"
          }
        }
      }
    },
    "gameCreatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleset", "seed"],
      "properties": {
        "ruleset": {
          "$ref": "#/definitions/rulesetIdentity"
        },
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "gameCreatedPayload": {
      "$ref": "#/definitions/gameCreatePayload"
    },
    "characterType": {
      "enum": ["townsfolk", "outsider", "minion", "demon", "traveler"]
    },
    "basicSeatInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seatId", "order", "characterType"],
      "properties": {
        "seatId": { "$ref": "#/definitions/stableId" },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "characterType": { "$ref": "#/definitions/characterType" }
      }
    },
    "basicSeatState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seatId",
        "order",
        "characterType",
        "alive",
        "deadVoteAvailable"
      ],
      "properties": {
        "seatId": { "$ref": "#/definitions/stableId" },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "characterType": { "$ref": "#/definitions/characterType" },
        "alive": { "type": "boolean" },
        "deadVoteAvailable": { "type": "boolean" }
      }
    },
    "executionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dayNumber", "seatId", "died"],
      "properties": {
        "dayNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "seatId": { "$ref": "#/definitions/stableId" },
        "died": { "type": "boolean" }
      }
    },
    "winnerState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alignment", "reason", "decidedAtRevision"],
      "properties": {
        "alignment": { "enum": ["good", "evil"] },
        "reason": { "enum": ["all-demons-dead", "two-alive"] },
        "decidedAtRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "allOf": [
        {
          "if": { "properties": { "alignment": { "const": "good" } } },
          "then": {
            "properties": { "reason": { "const": "all-demons-dead" } }
          },
          "else": { "properties": { "reason": { "const": "two-alive" } } }
        }
      ]
    },
    "voteDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seatId", "support", "usedDeadVote"],
      "properties": {
        "seatId": { "$ref": "#/definitions/stableId" },
        "support": { "type": "boolean" },
        "usedDeadVote": { "type": "boolean" }
      }
    },
    "activeNomination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominationId",
        "dayNumber",
        "nominatorSeatId",
        "nomineeSeatId",
        "stage",
        "votingOrder",
        "currentVoterIndex",
        "threshold",
        "decisions"
      ],
      "properties": {
        "nominationId": { "$ref": "#/definitions/stableId" },
        "dayNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nominatorSeatId": { "$ref": "#/definitions/stableId" },
        "nomineeSeatId": { "$ref": "#/definitions/stableId" },
        "stage": { "enum": ["defense", "voting", "ready-to-close"] },
        "votingOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/stableId" }
        },
        "currentVoterIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/definitions/voteDecision" }
        }
      }
    },
    "nominationResult": {
      "enum": ["candidate", "tie", "not-enough", "lower"]
    },
    "nominationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominationId",
        "dayNumber",
        "nominatorSeatId",
        "nomineeSeatId",
        "total",
        "threshold",
        "voterSeatIds",
        "result",
        "executionCandidateSeatId"
      ],
      "properties": {
        "nominationId": { "$ref": "#/definitions/stableId" },
        "dayNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nominatorSeatId": { "$ref": "#/definitions/stableId" },
        "nomineeSeatId": { "$ref": "#/definitions/stableId" },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "voterSeatIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/stableId" }
        },
        "result": { "$ref": "#/definitions/nominationResult" },
        "executionCandidateSeatId": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/definitions/stableId" }]
        }
      }
    },
    "executionCandidateState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seatId", "votes"],
      "properties": {
        "seatId": { "$ref": "#/definitions/stableId" },
        "votes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "exileDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seatId", "support"],
      "properties": {
        "seatId": { "$ref": "#/definitions/stableId" },
        "support": { "type": "boolean" }
      }
    },
    "activeExile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exileId",
        "dayNumber",
        "proposerSeatId",
        "travelerSeatId",
        "decisions"
      ],
      "properties": {
        "exileId": { "$ref": "#/definitions/stableId" },
        "dayNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "proposerSeatId": { "$ref": "#/definitions/stableId" },
        "travelerSeatId": { "$ref": "#/definitions/stableId" },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/definitions/exileDecision" }
        }
      }
    },
    "exileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exileId",
        "dayNumber",
        "proposerSeatId",
        "travelerSeatId",
        "supporterSeatIds",
        "total",
        "threshold",
        "succeeded"
      ],
      "properties": {
        "exileId": { "$ref": "#/definitions/stableId" },
        "dayNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "proposerSeatId": { "$ref": "#/definitions/stableId" },
        "travelerSeatId": { "$ref": "#/definitions/stableId" },
        "supporterSeatIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/stableId" }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "succeeded": { "type": "boolean" }
      }
    },
    "ruleSourceId": { "$ref": "#/definitions/stableId" },
    "gameStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seats"],
      "properties": {
        "seats": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/definitions/basicSeatInput" }
        }
      }
    },
    "gameStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seats", "ruleSourceId"],
      "properties": {
        "seats": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/definitions/basicSeatInput" }
        },
        "ruleSourceId": { "$ref": "#/definitions/ruleSourceId" }
      }
    },
    "emptyPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "phaseAdvancedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "dayNumber",
        "nightNumber",
        "reason",
        "ruleSourceId"
      ],
      "properties": {
        "from": { "enum": ["first-night", "day", "night"] },
        "to": { "enum": ["day", "night"] },
        "dayNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nightNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": { "enum": ["manual", "execution"] },
        "ruleSourceId": { "$ref": "#/definitions/ruleSourceId" }
      }
    },
    "lifeCommandPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seatId", "causeId"],
      "properties": {
        "seatId": { "$ref": "#/definitions/stableId" },
        "causeId": { "$ref": "#/definitions/stableId" },
        "sourceId": { "$ref": "#/definitions/stableId" }
      }
    },
    "lifeEventPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seatId", "causeId", "ruleSourceId"],
      "properties": {
        "seatId": { "$ref": "#/definitions/stableId" },
        "causeId": { "$ref": "#/definitions/stableId" },
        "sourceId": { "$ref": "#/definitions/stableId" },
        "ruleSourceId": { "$ref": "#/definitions/ruleSourceId" }
      }
    },
    "executionResolvePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seatId"],
      "properties": {
        "seatId": { "$ref": "#/definitions/stableId" }
      }
    },
    "nominationOpenPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nominationId", "nominatorSeatId", "nomineeSeatId"],
      "properties": {
        "nominationId": { "$ref": "#/definitions/stableId" },
        "nominatorSeatId": { "$ref": "#/definitions/stableId" },
        "nomineeSeatId": { "$ref": "#/definitions/stableId" }
      }
    },
    "nominationOpenedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominationId",
        "nominatorSeatId",
        "nomineeSeatId",
        "dayNumber",
        "ruleSourceId"
      ],
      "properties": {
        "nominationId": { "$ref": "#/definitions/stableId" },
        "nominatorSeatId": { "$ref": "#/definitions/stableId" },
        "nomineeSeatId": { "$ref": "#/definitions/stableId" },
        "dayNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ruleSourceId": { "$ref": "#/definitions/ruleSourceId" }
      }
    },
    "voteOpenPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nominationId"],
      "properties": {
        "nominationId": { "$ref": "#/definitions/stableId" }
      }
    },
    "voteOpenedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominationId",
        "nomineeSeatId",
        "votingOrder",
        "threshold",
        "ruleSourceId"
      ],
      "properties": {
        "nominationId": { "$ref": "#/definitions/stableId" },
        "nomineeSeatId": { "$ref": "#/definitions/stableId" },
        "votingOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/stableId" }
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ruleSourceId": { "$ref": "#/definitions/ruleSourceId" }
      }
    },
    "voteRecordPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nominationId", "voterSeatId", "support"],
      "properties": {
        "nominationId": { "$ref": "#/definitions/stableId" },
        "voterSeatId": { "$ref": "#/definitions/stableId" },
        "support": { "type": "boolean" }
      }
    },
    "voteRecordedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominationId",
        "voterSeatId",
        "support",
        "usedDeadVote",
        "ruleSourceId"
      ],
      "properties": {
        "nominationId": { "$ref": "#/definitions/stableId" },
        "voterSeatId": { "$ref": "#/definitions/stableId" },
        "support": { "type": "boolean" },
        "usedDeadVote": { "type": "boolean" },
        "ruleSourceId": { "$ref": "#/definitions/ruleSourceId" }
      }
    },
    "voteClosePayload": {
      "$ref": "#/definitions/voteOpenPayload"
    },
    "voteClosedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nominationId",
        "nomineeSeatId",
        "total",
        "threshold",
        "voterSeatIds",
        "result",
        "highestVotes",
        "executionCandidateSeatId",
        "ruleSourceId"
      ],
      "properties": {
        "nominationId": { "$ref": "#/definitions/stableId" },
